{
  "name": "devex-metrics",
  "version": "1.0.0",
  "description": "DevEx reporting and dashboarding for GitHub repos and organizations",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "save-fixture": "npm run build && node dist/save-fixture.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "stryker run",
    "mutation:ci": "stryker run --reporters json,clear-text",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devex-metrics/devex-metrics.git"
  },
  "keywords": [],
  "author": "",
  "license": "CC0-1.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/devex-metrics/devex-metrics/issues"
  },
  "homepage": "https://github.com/devex-metrics/devex-metrics#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
