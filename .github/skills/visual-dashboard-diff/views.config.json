{
  "$comment": [
    "Registry of the pages the visual diff renders. Each view names the fixture",
    "(an OrgMetrics snapshot) and the deployment config the site is built from,",
    "the selector that proves the page rendered, and the states (filter clicks,",
    "toggles) screenshotted on top of the initial render. Adding a control to",
    "the dashboard that reveals new content means adding a state for it here,",
    "or the visual diff will never see what you built.",
    "noiseFloorPixels is the per-view tolerance for Chart.js canvas anti-aliasing."
  ],
  "defaults": {
    "viewportWidth": 1280,
    "settleMs": 800
  },
  "views": [
    {
      "id": "dashboard",
      "title": "Dashboard",
      "fixture": "dashboard.json",
      "config": "dashboard.config.json",
      "expect": "section.kpis",
      "noiseFloorPixels": 800,
      "states": [
        {
          "id": "repo-details-30-days",
          "title": "Repository details, cap outside selected period",
          "steps": [{ "click": "[data-repo-name=\"issue-comment-tag\"] .repo-expand-btn" }],
          "expect": "#detail-devops-actions-issue-comment-tag:not([hidden]) .pr-tbl"
        },
        {
          "id": "repo-details-capped",
          "title": "Repository details, cap inside selected period",
          "steps": [
            { "click": ".filter-btn[data-period=\"120days\"]" },
            { "click": "[data-repo-name=\"issue-comment-tag\"] .repo-expand-btn" }
          ],
          "expect": "#detail-devops-actions-issue-comment-tag:not([hidden]) .repo-incomplete:not([hidden])"
        },
        {
          "id": "120-days",
          "title": "Last 120 Days period",
          "steps": [{ "click": ".filter-btn[data-period=\"120days\"]" }],
          "expect": ".filter-btn[data-period=\"120days\"].active"
        },
        {
          "id": "150-days",
          "title": "Last 150 Days period",
          "steps": [{ "click": ".filter-btn[data-period=\"150days\"]" }],
          "expect": ".filter-btn[data-period=\"150days\"].active"
        },
        {
          "id": "180-days",
          "title": "Last 180 Days period",
          "steps": [{ "click": ".filter-btn[data-period=\"180days\"]" }],
          "expect": ".filter-btn[data-period=\"180days\"].active"
        },
        {
          "id": "all-time",
          "title": "All Time period",
          "steps": [{ "click": ".filter-btn[data-period=\"all\"]" }],
          "expect": ".filter-btn[data-period=\"all\"].active"
        },
        {
          "id": "exclude-bots",
          "title": "Bots excluded",
          "steps": [{ "click": "#excludeBots" }],
          "expect": "#excludeBots:checked"
        }
      ]
    }
  ]
}
